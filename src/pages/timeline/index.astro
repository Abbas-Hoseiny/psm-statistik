---
/**
 * Timeline / Zulassungs-Statistiken
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartContainer from '../../components/ChartContainer.astro';
---

<BaseLayout title="Zeitverlauf" description="Erstzulassung, Zulassungsende und Bestand der heute zugelassenen Pflanzenschutzmittel in Deutschland">
  <div class="page">
    <header class="page-header">
      <h1>📅 Zulassungen im Zeitverlauf</h1>
      <p>Seit wann und bis wann die heute zugelassenen Pflanzenschutzmittel zugelassen sind. Die BVL-Datenbank enthält nur aktuell zugelassene Mittel.</p>
    </header>

    <div class="charts-stack">
      <ChartContainer 
        id="chart-zulassungen" 
        title="Erstzulassung der heute zugelassenen Mittel"
        note="Jahr der ersten Zulassung. Mittel, deren Zulassung inzwischen abgelaufen ist, fehlen in den Daten."
        height="400px"
      />
      
      <ChartContainer 
        id="chart-ablauf" 
        title="Zulassungsende in den nächsten zehn Jahren"
        note="Ende der aktuellen Zulassung, ohne mögliche Verlängerungen."
        height="350px"
      />

      <ChartContainer 
        id="chart-kumulativ" 
        title="Bestand der heute zugelassenen Mittel"
        note="Für vergangene Jahre: wie viele der heutigen Mittel schon zugelassen waren. Für kommende Jahre: wie viele ohne Verlängerung noch gelten."
        height="400px"
      />
    </div>
  </div>
</BaseLayout>

<script>
  import * as echarts from 'echarts';
  import { initDatabase, showLoadError } from '../../scripts/db';
  import { getZulassungenProJahr, getAblaufendeZulassungen, getBestandVerlauf } from '../../scripts/charts/queries';
  import { psmTheme, CHART_COLORS, getLineChartOptions, getBarChartOptions, isNarrow } from '../../scripts/charts/theme';

  echarts.registerTheme('psm', psmTheme);

  function hideLoading(chartId: string) {
    const loading = document.getElementById(`${chartId}-loading`);
    if (loading) loading.classList.add('hidden');
  }

  async function init() {
    await initDatabase();

    await Promise.all([
      loadZulassungenChart(),
      loadAblaufChart(),
      loadBestandChart()
    ]);
  }

  async function loadZulassungenChart() {
    const data = await getZulassungenProJahr();

    const chartEl = document.getElementById('chart-zulassungen');
    if (!chartEl) return;

    const chart = echarts.init(chartEl, 'psm');
    chart.setOption(getLineChartOptions(
      data.map(d => d.jahr),
      data.map(d => d.anzahl),
      ''
    ));

    hideLoading('chart-zulassungen');
    window.addEventListener('resize', () => chart.resize());
  }

  async function loadAblaufChart() {
    const data = await getAblaufendeZulassungen();
    const aktuellesJahr = new Date().getFullYear().toString();

    const chartEl = document.getElementById('chart-ablauf');
    if (!chartEl) return;

    const chart = echarts.init(chartEl, 'psm');
    chart.setOption({
      ...getBarChartOptions(
        data.map(d => d.jahr),
        data.map(d => d.anzahl),
        '',
        false
      ),
      series: [{
        type: 'bar',
        name: 'Zulassungsende',
        data: data.map(d => ({
          value: d.anzahl,
          itemStyle: {
            color: d.jahr === aktuellesJahr
              ? CHART_COLORS[3]  // Rot: endet noch in diesem Jahr
              : CHART_COLORS[2], // Amber: spätere Jahre
            borderRadius: [4, 4, 0, 0]
          }
        }))
      }]
    });

    hideLoading('chart-ablauf');
    window.addEventListener('resize', () => chart.resize());
  }

  async function loadBestandChart() {
    const { basis, jahre } = await getBestandVerlauf();

    // Gültig zum Jahresende: bisherige Erstzulassungen minus bisherige Zulassungsenden
    let bestand = basis;
    const verlauf = jahre.map(d => {
      bestand = bestand + d.neu - d.ende;
      return { jahr: d.jahr, bestand: Math.max(0, bestand), neu: d.neu, ende: d.ende };
    });

    const chartEl = document.getElementById('chart-kumulativ');
    if (!chartEl) return;

    const narrow = isNarrow();
    const chart = echarts.init(chartEl, 'psm');
    chart.setOption({
      tooltip: {
        trigger: 'axis',
        confine: true,
        backgroundColor: 'rgba(22, 44, 62, 0.95)',
        borderColor: '#2a3f52',
        textStyle: { color: '#e6f0f6' },
        valueFormatter: (v: any) => Math.abs(Number(v)).toLocaleString('de-DE')
      },
      legend: {
        data: ['Gültig zum Jahresende', 'Erstzulassungen', 'Zulassungsende'],
        textStyle: { color: '#a6b5c2', fontSize: narrow ? 10 : 12 }
      },
      grid: {
        left: '3%',
        right: '4%',
        top: narrow ? 48 : 40,
        bottom: '15%',
        containLabel: true
      },
      xAxis: {
        type: 'category',
        data: verlauf.map(d => d.jahr),
        axisLabel: { color: '#a6b5c2' },
        axisLine: { lineStyle: { color: '#2a3f52' } }
      },
      yAxis: {
        type: 'value',
        axisLabel: { color: '#a6b5c2', formatter: (v: number) => Math.abs(v).toLocaleString('de-DE') },
        splitLine: { lineStyle: { color: '#1b3448' } }
      },
      dataZoom: [
        { type: 'inside', start: 0, end: 100 },
        { type: 'slider', start: 0, end: 100 }
      ],
      series: [
        {
          name: 'Gültig zum Jahresende',
          type: 'line',
          data: verlauf.map(d => d.bestand),
          smooth: true,
          lineStyle: { width: 3, color: CHART_COLORS[0] },
          itemStyle: { color: CHART_COLORS[0] },
          areaStyle: {
            color: {
              type: 'linear',
              x: 0, y: 0, x2: 0, y2: 1,
              colorStops: [
                { offset: 0, color: 'rgba(34, 197, 94, 0.3)' },
                { offset: 1, color: 'rgba(34, 197, 94, 0.05)' }
              ]
            }
          }
        },
        {
          name: 'Erstzulassungen',
          type: 'bar',
          data: verlauf.map(d => d.neu),
          itemStyle: { color: CHART_COLORS[1], opacity: 0.7 }
        },
        {
          name: 'Zulassungsende',
          type: 'bar',
          data: verlauf.map(d => -d.ende),
          itemStyle: { color: CHART_COLORS[3], opacity: 0.7 }
        }
      ]
    });

    hideLoading('chart-kumulativ');
    window.addEventListener('resize', () => chart.resize());
  }

  init().catch(showLoadError);
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .page-header h1 {
    font-size: 1.5rem;
    margin: 0;
  }

  .page-header p {
    color: var(--text-muted);
    margin: var(--sp-2) 0 0 0;
  }

  .charts-stack {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
</style>
