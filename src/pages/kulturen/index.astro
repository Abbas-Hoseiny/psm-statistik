---
/**
 * Kulturen-Statistiken - mit deutschen Namen aus bvl_kode
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartContainer from '../../components/ChartContainer.astro';
import StatCard from '../../components/StatCard.astro';
---

<BaseLayout title="Kulturen">
  <div class="page">
    <header class="page-header">
      <h1>🌱 Kultur-Statistiken</h1>
      <p>Welche Kulturen haben die meisten zugelassenen Pflanzenschutzmittel?</p>
    </header>

    <!-- Übersichts-Karten -->
    <div class="stats-row" id="kultur-stats">
      <StatCard title="Kulturen & Objekte" statKey="kulturen" value="..." icon="🌾" />
      <StatCard title="Anwendungsgebiete" statKey="awg" value="..." icon="📋" color="info" />
      <StatCard title="Top Kultur" statKey="top-kultur" value="..." icon="🏆" color="warning" />
      <StatCard title="⌀ Anwendungsgebiete je Kultur" statKey="avg" value="..." icon="📊" color="danger" />
    </div>

    <!-- Haupt-Chart: Top Kulturen nach Zulassungen -->
    <div class="charts-grid">
      <ChartContainer 
        id="chart-kulturen-zulassungen"
        title="Top 25 Kulturen nach Anwendungsgebieten"
        height="600px"
        class="chart-full"
      />
    </div>

    <!-- Zweiter Chart: Kultur-Gruppen -->
    <div class="charts-row">
      <ChartContainer 
        id="chart-kultur-gruppen"
        title="Top 10 Kulturgruppen nach Anwendungsgebieten"
        note="Eine Kultur kann mehreren Gruppen angehören; je Gruppe zählt jedes Anwendungsgebiet einmal."
        height="400px"
      />
      <ChartContainer 
        id="chart-kultur-mittel"
        title="Top 10 Kulturen nach zugelassenen Mitteln"
        note="Anzahl der heute zugelassenen Mittel mit mindestens einem Anwendungsgebiet für die Kultur."
        height="400px"
      />
    </div>

    <!-- Tabelle mit Suche und Filter -->
    <section class="data-table-section">
      <div class="table-header">
        <h2>Alle Kulturen im Detail</h2>
        <div class="table-info" id="table-info">Lade Daten...</div>
      </div>
      
      <div class="table-controls">
        <input type="search" id="search-kultur" placeholder="Kultur suchen (z.B. Weizen, Apfel, Kartoffel)..." class="search-input" />
        <select id="filter-gruppe" class="filter-select">
          <option value="">Alle Gruppen</option>
        </select>
        <select id="sort-by" class="filter-select">
          <option value="awg">Nach Anwendungsgebieten</option>
          <option value="name">Nach Name (A-Z)</option>
        </select>
      </div>
      
      <div class="table-wrapper">
        <table class="data-table" id="kulturen-table">
          <thead>
            <tr>
              <th class="col-rank">#</th>
              <th class="col-kultur">Kultur</th>
              <th class="col-code">EPPO-Code</th>
              <th class="col-gruppe">Gruppen</th>
              <th class="col-awg">Anwendungs&shy;gebiete</th>
              <th class="col-anteil">Anteil an allen AWG</th>
            </tr>
          </thead>
          <tbody id="kulturen-tbody">
            <tr><td colspan="6" class="loading-row">Daten werden geladen...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import * as echarts from 'echarts';
  import { initDatabase, queryOne, showLoadError, esc } from '../../scripts/db';
  import { getKulturenDetail, getKulturGruppen, getMittelJeKultur, type KulturRow } from '../../scripts/charts/queries';
  import { psmTheme, CHART_COLORS, getBarChartOptions, isNarrow } from '../../scripts/charts/theme';

  echarts.registerTheme('psm', psmTheme);

  const GRUPPEN_TRENNER = ' · ';

  let allKulturen: KulturRow[] = [];
  let totalAwg = 0;

  const gruppenVon = (k: KulturRow) => (k.gruppen ? k.gruppen.split(GRUPPEN_TRENNER) : []);

  function hideLoading(chartId: string) {
    const loading = document.getElementById(`${chartId}-loading`);
    if (loading) loading.classList.add('hidden');
  }

  function updateStatCard(key: string, value: string | number) {
    const el = document.querySelector(`[data-stat="${key}"]`);
    if (el) {
      el.textContent = typeof value === 'number' ? value.toLocaleString('de-DE') : value;
    }
  }

  async function init() {
    await initDatabase();

    // Kulturen mit deutschen Namen (Kodeliste 948) und ihren Gruppen; ausgenommene Kulturen zählen nicht
    allKulturen = await getKulturenDetail();

    const awg = await queryOne<{ anzahl: number }>(
      "SELECT COUNT(DISTINCT awg_id) AS anzahl FROM bvl_awg_kultur WHERE ausgenommen = 'N'"
    );
    totalAwg = awg?.anzahl ?? 0;
    const verknuepfungen = allKulturen.reduce((sum, k) => sum + k.awg_count, 0);

    populateFilterDropdown();

    updateStatCard('kulturen', allKulturen.length);
    updateStatCard('awg', totalAwg);
    if (allKulturen.length > 0) {
      updateStatCard('top-kultur', allKulturen[0].kultur_name);
    }
    updateStatCard(
      'avg',
      allKulturen.length > 0
        ? (verknuepfungen / allKulturen.length).toLocaleString('de-DE', { maximumFractionDigits: 1 })
        : '0'
    );

    await Promise.all([
      loadKulturenChart(),
      loadKulturGruppenChart(),
      loadMittelJeKulturChart()
    ]);

    renderTable(allKulturen);

    document.getElementById('search-kultur')?.addEventListener('input', filterAndRenderTable);
    document.getElementById('filter-gruppe')?.addEventListener('change', filterAndRenderTable);
    document.getElementById('sort-by')?.addEventListener('change', filterAndRenderTable);
  }

  function populateFilterDropdown() {
    const select = document.getElementById('filter-gruppe') as HTMLSelectElement;
    if (!select) return;

    const gruppen = [...new Set(allKulturen.flatMap(gruppenVon))].sort((a, b) => a.localeCompare(b, 'de'));
    gruppen.forEach(gruppe => {
      const option = document.createElement('option');
      option.value = gruppe;
      option.textContent = gruppe;
      select.appendChild(option);
    });
  }

  async function loadKulturenChart() {
    const top25 = allKulturen.slice(0, 25).reverse();
    const narrow = isNarrow();

    const chartEl = document.getElementById('chart-kulturen-zulassungen');
    if (!chartEl) return;

    const chart = echarts.init(chartEl, 'psm');

    chart.setOption({
      tooltip: {
        trigger: 'axis',
        axisPointer: { type: 'shadow' },
        confine: true,
        formatter: (params: any) => {
          const kultur = top25[params[0]?.dataIndex];
          if (!kultur) return '';
          const percent = totalAwg ? ((kultur.awg_count / totalAwg) * 100).toLocaleString('de-DE', { maximumFractionDigits: 1 }) : '0';
          return `
            <strong>${esc(kultur.kultur_name)}</strong><br/>
            EPPO-Code: <code>${esc(kultur.kultur_code)}</code><br/>
            <span style="color: ${CHART_COLORS[0]}">●</span> Anwendungsgebiete: <strong>${kultur.awg_count.toLocaleString('de-DE')}</strong><br/>
            Anteil an allen Anwendungsgebieten: ${percent} %
          `;
        }
      },
      grid: {
        left: '3%',
        right: narrow ? '12%' : '6%',
        top: '3%',
        bottom: '3%',
        containLabel: true
      },
      xAxis: {
        type: 'value',
        splitNumber: narrow ? 3 : undefined,
        axisLabel: { color: '#a6b5c2', hideOverlap: true, formatter: (v: number) => v.toLocaleString('de-DE') },
        splitLine: { lineStyle: { color: '#1b3448' } }
      },
      yAxis: {
        type: 'category',
        data: top25.map(k => k.kultur_name),
        axisLabel: {
          color: '#a6b5c2',
          width: narrow ? 110 : 190,
          overflow: 'truncate',
          ellipsis: '…',
          fontSize: 11
        },
        axisLine: { lineStyle: { color: '#2a3f52' } }
      },
      series: [{
        name: 'Anwendungsgebiete',
        type: 'bar',
        data: top25.map((k, i) => ({
          value: k.awg_count,
          itemStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
              { offset: 0, color: CHART_COLORS[i % CHART_COLORS.length] },
              { offset: 1, color: CHART_COLORS[(i + 1) % CHART_COLORS.length] }
            ]),
            borderRadius: [0, 4, 4, 0]
          }
        })),
        emphasis: {
          itemStyle: {
            shadowBlur: 10,
            shadowColor: 'rgba(0,0,0,0.3)'
          }
        },
        label: {
          show: true,
          position: 'right',
          color: '#a6b5c2',
          fontSize: 10,
          formatter: (p: any) => Number(p.value).toLocaleString('de-DE')
        }
      }]
    });

    hideLoading('chart-kulturen-zulassungen');
    window.addEventListener('resize', () => chart.resize());
  }

  async function loadKulturGruppenChart() {
    const data = await getKulturGruppen(10);

    const chartEl = document.getElementById('chart-kultur-gruppen');
    if (!chartEl) return;

    const chart = echarts.init(chartEl, 'psm');
    chart.setOption(getBarChartOptions(
      data.map(d => d.gruppe),
      data.map(d => d.anzahl),
      '',
      true
    ));

    hideLoading('chart-kultur-gruppen');
    window.addEventListener('resize', () => chart.resize());
  }

  async function loadMittelJeKulturChart() {
    const data = await getMittelJeKultur(10);

    const chartEl = document.getElementById('chart-kultur-mittel');
    if (!chartEl) return;

    const chart = echarts.init(chartEl, 'psm');
    chart.setOption(getBarChartOptions(
      data.map(d => d.kultur),
      data.map(d => d.anzahl),
      '',
      true
    ));

    hideLoading('chart-kultur-mittel');
    window.addEventListener('resize', () => chart.resize());
  }

  function filterAndRenderTable() {
    const searchTerm = (document.getElementById('search-kultur') as HTMLInputElement)?.value.toLowerCase() || '';
    const gruppeFilter = (document.getElementById('filter-gruppe') as HTMLSelectElement)?.value || '';
    const sortBy = (document.getElementById('sort-by') as HTMLSelectElement)?.value || 'awg';

    let filtered = allKulturen;

    // Suche in deutschem Namen, EPPO-Code und Gruppen
    if (searchTerm) {
      filtered = filtered.filter(k =>
        k.kultur_name.toLowerCase().includes(searchTerm) ||
        k.kultur_code.toLowerCase().includes(searchTerm) ||
        (k.gruppen || '').toLowerCase().includes(searchTerm)
      );
    }

    if (gruppeFilter) {
      filtered = filtered.filter(k => gruppenVon(k).includes(gruppeFilter));
    }

    filtered = [...filtered].sort((a, b) => {
      switch (sortBy) {
        case 'name': return a.kultur_name.localeCompare(b.kultur_name, 'de');
        default: return b.awg_count - a.awg_count;
      }
    });

    renderTable(filtered);
  }

  function renderTable(data: KulturRow[]) {
    const tbody = document.getElementById('kulturen-tbody');
    const info = document.getElementById('table-info');
    if (!tbody) return;

    if (info) {
      info.textContent = `${data.length.toLocaleString('de-DE')} Kulturen`;
    }

    if (data.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="loading-row">Keine Ergebnisse gefunden</td></tr>';
      return;
    }

    const maxAwg = Math.max(...data.map(k => k.awg_count));

    tbody.innerHTML = data.slice(0, 150).map((k, i) => {
      const percent = ((k.awg_count / maxAwg) * 100).toFixed(1);
      const anteilGesamt = totalAwg ? ((k.awg_count / totalAwg) * 100).toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '0';
      const gruppen = gruppenVon(k);
      return `
        <tr>
          <td class="col-rank">${i + 1}</td>
          <td class="col-kultur">
            <span class="kultur-name">${esc(k.kultur_name)}</span>
            <div class="kultur-sub">${esc(k.kultur_code)}${gruppen.length ? ' · ' + gruppen.map(esc).join(', ') : ''}</div>
          </td>
          <td class="col-code">
            <code class="eppo-code">${esc(k.kultur_code)}</code>
          </td>
          <td class="col-gruppe">
            ${gruppen.length ? gruppen.map(g => `<span class="gruppe-badge">${esc(g)}</span>`).join(' ') : '<span class="text-dim">–</span>'}
          </td>
          <td class="col-awg">
            <div class="awg-bar">
              <div class="awg-fill" style="width: ${percent}%"></div>
              <span class="awg-count">${k.awg_count.toLocaleString('de-DE')}</span>
            </div>
          </td>
          <td class="col-anteil">${anteilGesamt} %</td>
        </tr>
      `;
    }).join('');

    if (data.length > 150) {
      tbody.innerHTML += `<tr><td colspan="6" class="info-row">... und ${(data.length - 150).toLocaleString('de-DE')} weitere Kulturen</td></tr>`;
    }
  }

  init().catch(showLoadError);
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .page-header h1 {
    font-size: 1.5rem;
    margin: 0;
  }

  .page-header p {
    color: var(--text-muted);
    margin: var(--sp-2) 0 0 0;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--sp-4);
  }

  .charts-grid {
    display: grid;
    gap: var(--sp-4);
  }

  .charts-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: var(--sp-4);
  }

  .chart-full {
    width: 100%;
  }

  .data-table-section {
    background: var(--surface-1);
    border: 1px solid var(--border-1);
    border-radius: var(--r-lg);
    padding: var(--sp-4);
  }

  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sp-4);
  }

  .table-header h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .table-info {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .table-controls {
    display: flex;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: min(100%, 250px);
    max-width: 400px;
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--r-md);
    color: var(--text);
    font-size: 0.9rem;
  }

  .filter-select {
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--r-md);
    color: var(--text);
    font-size: 0.85rem;
    cursor: pointer;
    min-width: 0;
    max-width: 100%;
    text-overflow: ellipsis;
  }

  .search-input:focus,
  .filter-select:focus {
    outline: none;
    border-color: var(--primary);
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }


















  @media (max-width: 768px) {
    .charts-row {
      grid-template-columns: 1fr;
    }
    
    .table-controls {
      flex-direction: column;
    }
    
    .search-input,
    .filter-select {
      width: 100%;
      max-width: none;
    }
  }
</style>

<style is:global>
  /* Tabellenzeilen entstehen per Skript (innerHTML) und tragen kein Astro-Scope-Attribut,
     daher global, aber auf diese Tabelle begrenzt. */
  #kulturen-table th,
  #kulturen-table td {
    padding: var(--sp-2) var(--sp-3);
    text-align: left;
    border-bottom: 1px solid var(--border-1);
    vertical-align: top;
  }
  #kulturen-table th {
    background: var(--surface-2);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    position: sticky;
    top: 0;
    z-index: 1;
    vertical-align: bottom;
  }
  #kulturen-table tbody tr:hover { background: var(--surface-2); }
  #kulturen-table .col-rank { width: 40px; text-align: center; color: var(--text-dim); }
  #kulturen-table .col-kultur { min-width: 150px; }
  #kulturen-table .kultur-name { font-weight: 500; }
  #kulturen-table .col-code { min-width: 90px; }
  #kulturen-table .eppo-code {
    font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
    font-size: 0.75rem;
    background: var(--surface-3);
    padding: 2px 6px;
    border-radius: var(--r-sm);
    color: var(--primary);
  }
  #kulturen-table .col-gruppe { min-width: 200px; }
  #kulturen-table .gruppe-badge {
    display: inline-block;
    margin: 0 4px 4px 0;
    padding: 2px 8px;
    background: var(--surface-3);
    border-radius: var(--r-sm);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  #kulturen-table .col-awg,
  #kulturen-table .col-anteil { text-align: right; white-space: nowrap; }
  #kulturen-table .col-awg { min-width: 150px; }
  #kulturen-table .awg-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 24px;
    background: var(--surface-2);
    border-radius: var(--r-sm);
    overflow: hidden;
  }
  #kulturen-table .awg-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    min-width: 4px;
    background: linear-gradient(90deg, var(--primary), #4ade80);
    opacity: 0.3;
  }
  #kulturen-table .awg-count { position: relative; z-index: 1; font-weight: 600; padding: 0 var(--sp-2); }
  #kulturen-table .col-anteil { color: var(--text-muted); font-size: 0.8rem; }
  #kulturen-table .loading-row,
  #kulturen-table .info-row { text-align: center; color: var(--text-dim); padding: var(--sp-6); }
  #kulturen-table .text-dim { color: var(--text-dim); }
  #kulturen-table .kultur-sub { display: none; }

  /* Handy: Code und Gruppen unter dem Namen, Nebenspalten aus – die Zahl bleibt sichtbar */
  @media (max-width: 600px) {
    #kulturen-table .col-code,
    #kulturen-table .col-gruppe,
    #kulturen-table .col-anteil { display: none; }
    #kulturen-table .kultur-sub {
      display: block;
      margin-top: 2px;
      font-size: 0.75rem;
      color: var(--text-dim);
      line-height: 1.4;
    }
    #kulturen-table .col-kultur { min-width: 0; }
    #kulturen-table .col-rank { width: 30px; }
    #kulturen-table .col-awg { min-width: 96px; }
    #kulturen-table .kultur-name,
    #kulturen-table .kultur-sub { hyphens: auto; overflow-wrap: anywhere; }
    #kulturen-table th,
    #kulturen-table td { padding: var(--sp-2); }
    #kulturen-table th { text-transform: none; font-size: 0.75rem; }
  }
</style>
