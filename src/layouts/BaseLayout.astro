---
/**
 * Base Layout für PSM Statistik Dashboard
 * Verwendet Design-Tokens aus dem Haupt-PSM-Projekt
 */
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Statistik-Dashboard für Pflanzenschutzmittel-Daten' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://st.digitale-psm.de').href;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const BVL_URL = 'https://www.bvl.bund.de/DE/Arbeitsbereiche/04_Pflanzenschutzmittel/pflanzenschutzmittel_node.html';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{title} | PSM Statistik - Pflanzenschutzmittel Datenbank</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Pflanzenschutzmittel, PSM, BVL, Statistik, Wirkstoffe, Kulturen, Zulassungen, Landwirtschaft, Deutschland, Pflanzenschutz" />
    <meta name="author" content="Abbas Hoseiny" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | PSM Statistik`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://st.digitale-psm.de/og-image.png" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="PSM Statistik" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | PSM Statistik`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://st.digitale-psm.de/og-image.png" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#22c55e" />
  </head>
  <body>
    <header class="header">
      <div class="header-content">
        <a href="/" class="logo">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 3v18h18" />
            <path d="M18 9l-5 5-4-4-3 3" />
          </svg>
          <span>PSM Statistik</span>
        </a>
        <nav class="nav" aria-label="Bereiche">
          <a href="/" class:list={[{ active: isActive('/') }]}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>
            <span>Übersicht</span>
          </a>
          <a href="/wirkstoffe/" class:list={[{ active: isActive('/wirkstoffe/') }]}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7.5 14h9"/></svg>
            <span>Wirkstoffe</span>
          </a>
          <a href="/kulturen/" class:list={[{ active: isActive('/kulturen/') }]}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V11"/><path d="M12 11C12 7 9 5 5 5c0 4 3 6 7 6z"/><path d="M12 13c0-4 3-6 7-6 0 4-3 6-7 6z"/></svg>
            <span>Kulturen</span>
          </a>
          <a href="/timeline/" class:list={[{ active: isActive('/timeline/') }]}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            <span>Zeitverlauf</span>
          </a>
        </nav>
        <a href="https://digitale-psm.de" class="back-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
          <span>Zur App</span>
        </a>
      </div>
    </header>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-content">
        <div class="footer-links">
          <a href="https://digitale-psm.de" target="_blank" rel="noopener">
            🌱 Digitale PSM
          </a>
          <span class="divider">·</span>
          <a href="https://info.digitale-psm.de" target="_blank" rel="noopener">
            ℹ️ Info & Lizenz
          </a>
          <span class="divider">·</span>
          <a href="https://github.com/Abbas-Hoseiny/psm-statistik" target="_blank" rel="noopener">
            💻 Quellcode
          </a>
        </div>
        <div class="footer-info">
          Daten: <a href={BVL_URL} target="_blank" rel="noopener">Bundesamt für Verbraucherschutz und Lebensmittelsicherheit (BVL)</a>,
          aufbereitet in <a href="https://github.com/Abbas-Hoseiny/pflanzenschutz-db" target="_blank" rel="noopener">pflanzenschutz-db</a> · Aktualisierung alle 2 Tage
        </div>
        <div class="footer-copyright">
          © 2025–2026 <a href="https://hoseiny.de/de/projects/digitale-psm/" target="_blank" rel="noopener">Abbas Hoseiny</a> · Open Source unter MIT-Lizenz
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /**
   * PSM Statistik Theme
   * Abgeleitet vom Haupt-PSM Design System
   */
  :root {
    /* ═══ Hintergrund ═══ */
    --bg-0: #0b1620;
    --bg-1: #0e1d2a;
    --surface-1: #122433;
    --surface-2: #162c3e;
    --surface-3: #1b3448;

    /* ═══ Text ═══ */
    --text: #e6f0f6;
    --text-muted: #a6b5c2;
    --text-dim: #7e93a4;

    /* ═══ Rahmen ═══ */
    --border-1: #2a3f52;
    --border-2: #36536b;

    /* ═══ Primärfarbe (Grün) ═══ */
    --primary: #22c55e;
    --primary-hover: #16a34a;
    --primary-subtle: rgba(34, 197, 94, 0.18);

    /* ═══ Diagramm-Farben ═══ */
    --chart-1: #22c55e;  /* Grün */
    --chart-2: #22d3ee;  /* Cyan */
    --chart-3: #fbbf24;  /* Amber */
    --chart-4: #ef4444;  /* Rot */
    --chart-5: #8b5cf6;  /* Violett */
    --chart-6: #f472b6;  /* Pink */
    --chart-7: #64748b;  /* Slate */
    --chart-8: #06b6d4;  /* Teal */

    /* ═══ Radien ═══ */
    --r-sm: 4px;
    --r-md: 8px;
    --r-lg: 12px;

    /* ═══ Schatten ═══ */
    --shadow-1: 0 8px 24px rgba(0, 0, 0, 0.35);
    --shadow-2: 0 14px 40px rgba(0, 0, 0, 0.45);

    /* ═══ Spacing ═══ */
    --sp-1: 0.25rem;
    --sp-2: 0.5rem;
    --sp-3: 0.75rem;
    --sp-4: 1rem;
    --sp-6: 1.5rem;
    --sp-8: 2rem;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: radial-gradient(ellipse 120% 80% at 50% -10%, #1e3a5f 0%, #081019 60%);
    background-color: var(--bg-0);
    color: var(--text);
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--primary);
  }
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface-1);
    border-bottom: 1px solid var(--border-1);
    backdrop-filter: blur(8px);
  }

  .header-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--sp-3) var(--sp-6);
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--primary);
  }

  .logo:hover {
    color: var(--primary-hover);
  }

  .nav {
    display: flex;
    gap: var(--sp-2);
    flex: 1;
  }

  .nav a,
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .nav a {
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-md);
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .nav a:hover,
  .nav a.active {
    background: var(--primary-subtle);
    color: var(--primary);
  }

  .nav svg,
  .back-link svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .back-link {
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  .main {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--sp-6);
    min-height: calc(100vh - 140px);
  }

  .footer {
    border-top: 1px solid var(--border-1);
    padding: var(--sp-6) var(--sp-6);
    text-align: center;
    color: var(--text-dim);
    font-size: 0.8rem;
    background: var(--surface-1);
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color 0.2s;
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--r-sm);
  }

  .footer-links a:hover {
    color: var(--primary);
    background: var(--primary-subtle);
  }

  .footer-links .divider {
    color: var(--border-2);
  }

  .footer-info {
    color: var(--text-dim);
  }

  .footer-info a,
  .footer-copyright a {
    color: var(--text-muted);
  }

  .footer-copyright {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-top: var(--sp-2);
  }

  @media (max-width: 768px) {
    .header-content {
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      padding: var(--sp-3) var(--sp-4);
    }

    .back-link {
      margin-left: auto;
    }

    /* Alle vier Bereiche immer sichtbar: eigene Zeile, gleich breit, Icon über dem Namen */
    .nav {
      order: 3;
      flex-basis: 100%;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-1);
    }

    .nav a {
      flex-direction: column;
      gap: 2px;
      padding: var(--sp-2) 2px;
      font-size: 0.75rem;
      text-align: center;
    }

    .nav svg {
      width: 20px;
      height: 20px;
    }

    .main {
      padding: var(--sp-4);
    }
  }
</style>
